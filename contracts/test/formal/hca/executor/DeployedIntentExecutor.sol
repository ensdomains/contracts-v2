pragma solidity 0.8.27;

import {Vm} from "forge-std/Vm.sol";

/// @title Deployed Rhinestone IntentExecutor Fixture
/// @notice Installs pinned mainnet or Sepolia proxy and implementation bytecode without recompilation.
/// @dev Generated from fixtures/intent-executor.json. The upstream runtime remains unmodified.
///      Proxy control slots reflect the pinned block; account-specific state starts unused.
///      Upstream license and source-verification provenance accompany the runtime snapshot.
library DeployedIntentExecutor {
    address internal constant PROXY = 0x00000000005aD9ce1f5035FD62CA96CEf16AdAAF;
    address internal constant IMPLEMENTATION = 0x194DE341d4791e9b8922eE1bC018DFd1fD1b115A;
    address internal constant PROXY_OWNER = 0x61e8AC0a758AfEEFBD556f713ecF0A8cbd00288f;
    bytes32 internal constant IMPLEMENTATION_SLOT = bytes32(uint256(0x911c5a209f08d5ec5e));
    bytes32 internal constant OWNER_SLOT = bytes32(uint256(0x4343a0dc92ed22dbfc));
    bytes32 internal constant PROXY_CODE_HASH =
        0xd23247796c75f502bb7b872631c55da669b2b167d874930f7d98bce2b1d615ba;
    bytes32 internal constant MAINNET_CODE_HASH =
        0xbc3eef7e70cf5eb058a1e9eb21ac725b3c95511f878b8329217ef6f8424c5a5a;
    bytes32 internal constant SEPOLIA_CODE_HASH =
        0x50f5509a0b2fa8a667bedbc5d1e4432755082617213fb63ddead0e911f97d7c4;
    Vm private constant VM = Vm(address(uint160(uint256(keccak256("hevm cheat code")))));

    /// @notice Recreates both deployed code layers and their pinned proxy control state.
    /// @param sepolia Whether to use the Sepolia chain and immutable values.
    /// @return executor The real executor's fixed proxy address.
    function install(bool sepolia) internal returns (address executor) {
        VM.chainId(sepolia ? 11155111 : 1);
        VM.etch(PROXY, proxyRuntime());
        VM.etch(IMPLEMENTATION, sepolia ? sepoliaRuntime() : mainnetRuntime());
        VM.store(PROXY, IMPLEMENTATION_SLOT, bytes32(uint256(uint160(IMPLEMENTATION))));
        VM.store(PROXY, OWNER_SLOT, bytes32(uint256(uint160(PROXY_OWNER))));
        assert(PROXY.codehash == PROXY_CODE_HASH);
        assert(IMPLEMENTATION.codehash == (sepolia ? SEPOLIA_CODE_HASH : MAINNET_CODE_HASH));
        return PROXY;
    }

    /// @notice Returns the exact proxy runtime shared by both pinned networks.
    function proxyRuntime() internal pure returns (bytes memory) {
        return
            hex"";
    }

    /// @notice Returns the exact mainnet implementation runtime with deployed immutables.
    function mainnetRuntime() internal pure returns (bytes memory) {
        return
            hex"";
    }

    /// @notice Returns the exact Sepolia implementation runtime with deployed immutables.
    function sepoliaRuntime() internal pure returns (bytes memory) {
        return
            hex"";
    }
}
